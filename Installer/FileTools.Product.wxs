<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="FileTools" Manufacturer="FileTools contributors" Version="0.2.0" UpgradeCode="5B73923E-FA10-4A21-998A-47F158EAEC1D" Scope="perUser" Language="1046" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do FileTools está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="FileToolsIcon" SourceFile="..\Resources\FileTools.ico" />
    <Property Id="ARPPRODUCTICON" Value="FileToolsIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/fesalvian/FileConverter" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <PropertyRef Id="WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED" />
    <Launch Condition="Installed OR (VersionNT64 AND WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED)" Message="O FileTools requer Windows x64 e .NET Framework 4.8. Instale o .NET Framework 4.8 antes de continuar." />
    <Property Id="VCRUNTIME140">
      <DirectorySearch Id="FindSystem32" Path="[System64Folder]"><FileSearch Id="FindVcRuntime" Name="vcruntime140.dll" MinVersion="14.0.0.0" /></DirectorySearch>
    </Property>
    <Launch Condition="Installed OR VCRUNTIME140" Message="Instale o Microsoft Visual C++ Redistributable v14 x64 antes de instalar o FileTools." />
    <Feature Id="Main" Title="FileTools" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="ShellRegistration" />
    </Feature>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FileTools">
          <Component Id="ShellRegistration" Guid="3E8715B6-FE88-40A5-927F-D0B8E5076E48">
            <RegistryValue Root="HKCU" Key="Software\FileTools" Name="InstallerVersion" Type="string" Value="0.2.0" KeyPath="yes" />
            <RegistryValue Root="HKCU" Key="Software\Classes\*\shellex\ContextMenuHandlers\FileTools" Type="string" Value="{2776E742-1628-40AA-97F0-F7805F77DAB2}" />
            <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{2776E742-1628-40AA-97F0-F7805F77DAB2}" Type="string" Value="FileTools" />
            <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{2776E742-1628-40AA-97F0-F7805F77DAB2}\InprocServer32" Type="string" Value="mscoree.dll" />
            <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{2776E742-1628-40AA-97F0-F7805F77DAB2}\InprocServer32" Name="ThreadingModel" Type="string" Value="Both" />
            <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{2776E742-1628-40AA-97F0-F7805F77DAB2}\InprocServer32" Name="Class" Type="string" Value="FileConverterExtension.FileConverterExtension" />
            <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{2776E742-1628-40AA-97F0-F7805F77DAB2}\InprocServer32" Name="Assembly" Type="string" Value="$(var.ShellAssembly)" />
            <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{2776E742-1628-40AA-97F0-F7805F77DAB2}\InprocServer32" Name="RuntimeVersion" Type="string" Value="v4.0.30319" />
            <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{2776E742-1628-40AA-97F0-F7805F77DAB2}\InprocServer32" Name="CodeBase" Type="string" Value="file:///[INSTALLFOLDER]FileConverterExtension.dll" />
            <RemoveFolder Id="RemoveAppFolder" On="uninstall" /><RemoveFolder Id="RemoveEmptyPrograms" Directory="ProgramsFolder" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
